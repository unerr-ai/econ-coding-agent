{
  "$schema": "./packages/opencode/opencode.schema.json",

  // econ conductor tier (S1.1) — the 'Engineer' role (docs/design/models.md, Part II).
  // The conductor is DeepSeek V4 Flash: a cheap, fast, agentic OSS engineer that plans the job,
  // decides each step, and carries the working context for every turn by default. 1M-token context
  // keeps the prompt cache warm across turns and the bill tiny ($0.14/$0.28 per M). Served through
  // econ's self-hosted LiteLLM gateway, which fronts deepseek-v4-flash, glm-5.2, deepseek-v4-pro,
  // and gpt-oss-120b with usage passthrough. A live run requires LITELLM_API_KEY.
  "default_agent": "conductor",

  // econ small_model (S8.3) — the 'Assistant' role. Cheap stateless model for incidental tasks
  // (title generation, summaries). Pinned to the executor/Assistant tier (gpt-oss-120b) so
  // housekeeping never pays conductor/oracle rates.
  "small_model": "litellm/openai/gpt-oss-120b",

  // econ top-level default model — the fallback for any agent with no model pinned.
  // MUST be an econ tier: without it, OpenCode's defaultModel() (provider.ts:1897) falls back to
  // the last recently-used model or the top of the models.dev catalog — which surfaced
  // an unsupported model (e.g. Nano Banana Pro, an image model) on the native build/plan agents.
  // Pinned to the conductor tier so every fallback lands on a supported econ model.
  "model": "litellm/minimax/minimax-m3",

  "agent": {
    // Disable OpenCode's native primary agents so the Tab switcher only cycles econ's tiers.
    // build/plan are hardcoded in src/agent/agent.ts and ship model-less; leaving them enabled
    // put "build · <default model>" in the switcher and let it resolve to an unsupported model.
    "build": { "disable": true },
    "plan": { "disable": true },
    "conductor": {
      "model": "litellm/minimax/minimax-m3",
      "description": "econ default conductor — the 'Engineer' (MODEL_SELECTION §1): DeepSeek V4 Flash, cheap+fast agentic OSS workhorse for everyday coding turns; plans, decides, holds context (S1.1). Served through econ's self-hosted LiteLLM gateway; 1M ctx, $0.14/$0.28 per M.",
      "mode": "primary"
    },
    "oracle": {
      "model": "litellm/z-ai/glm-5.2",
      "description": "econ oracle tier — the 'Expert' (MODEL_SELECTION §1): GLM 5.2, top open-weight coding score (SWE-bench Pro 62.1); called rarely for high-risk turns (S3.2, escalateAbove=70)",
      "mode": "primary"
    },
    "reasoner": {
      "model": "litellm/deepseek/deepseek-v4-pro",
      "description": "econ reasoner tier (OL-8.B4+): DeepSeek V4 Pro, a distinct model family from both the conductor and the oracle — deliberate verifier de-correlation — for hard steps (S3.7 hardStep) that don't warrant the full Expert escalation. 4 distinct models total (MODEL_SELECTION §1 pins no reasoner role).",
      "mode": "primary",
      "hidden": true
    },
    "executor": {
      "model": "litellm/openai/gpt-oss-120b",
      "description": "econ executor tier — the 'Assistant' (MODEL_SELECTION §1): gpt-oss-120b (OL-8.B4+, was gpt-oss-20b — 20b carries no function-calling tag on Fireworks serverless) for delegable chores — recon/lint/docstrings (S4.1); spawned per-task via the task tool, returns a digest",
      "mode": "subagent",
      "permission": { "task": "deny", "question": "deny" },
      "tools": { "todowrite": false }
    },

    // OL-9.1c — six stateless executor-persona intern agents (persona-deltas-design.md), all
    // backed by the executor tier's model with their own prompt delta (session/prompts/personas.ts
    // PERSONA_DELTA) and the full executor toolset — mirrors econ-defaults.ts econDefaultConfig()
    // (drift test: packages/opencode/test/config/econ-defaults.test.ts). Personas differ only by
    // prompt delta and step budget; the childSlicePermission overlay (slice-orchestrator.ts) grants
    // edit/bash/web at dispatch and re-denies the danger bash patterns for every seat alike.
    "explorer": {
      "model": "litellm/openai/gpt-oss-120b",
      "description": "econ persona — read-only recon intern: investigates one question, returns a digest, never edits.",
      "mode": "subagent",
      "hidden": true,
      "permission": { "task": "deny", "question": "deny" },
      "tools": { "task": false, "question": false, "todowrite": false }
    },
    "runner": {
      "model": "litellm/openai/gpt-oss-120b",
      "description": "econ persona — command intern: runs the brief's exact commands in order and reports what happened.",
      "mode": "subagent",
      "hidden": true,
      "permission": { "task": "deny", "question": "deny" },
      "tools": { "task": false, "question": false, "todowrite": false }
    },
    "applier": {
      "model": "litellm/openai/gpt-oss-120b",
      "description": "econ persona — edit intern: applies exactly the specified change, verifies it, and reports.",
      "mode": "subagent",
      "hidden": true,
      "permission": { "task": "deny", "question": "deny" },
      "tools": { "task": false, "question": false, "todowrite": false }
    },
    "author": {
      "model": "litellm/openai/gpt-oss-120b",
      "description": "econ persona — scoped creation intern: writes new tests/docstrings/scaffolds, never touches existing behavior.",
      "mode": "subagent",
      "hidden": true,
      "permission": { "task": "deny", "question": "deny" },
      "tools": { "task": false, "question": false, "todowrite": false }
    },
    "researcher": {
      "model": "litellm/openai/gpt-oss-120b",
      "description": "econ persona — docs/web lookup intern: answers a lookup question from sources it actually fetched.",
      "mode": "subagent",
      "hidden": true,
      "permission": { "task": "deny", "question": "deny" },
      "tools": { "task": false, "question": false, "todowrite": false }
    },
    "procedure": {
      "model": "litellm/openai/gpt-oss-120b",
      "description": "econ persona — step-by-step intern: executes the brief's numbered procedure and reports per step.",
      "mode": "subagent",
      "hidden": true,
      "permission": { "task": "deny", "question": "deny" },
      "tools": { "task": false, "question": false, "todowrite": false }
    }
  },

  // econ safe permission defaults (S8.3 hardening; bash broadened 2026-07-15). Read-only tools
  // and the majority of bash commands are ALLOW so a headless `opencode run` can build/test/run
  // (the permission/index.ts headless backstop turns every `ask` into a deny, so an ask-by-default
  // bash starves the agent). Edit and web (webfetch/websearch) are ALLOW too, so every tier — the
  // root conductor included — is fully capable headless; out-of-project access and delegate are
  // denied (delegate is slice-seat-only). The bash danger floor (destructive deletes, disk wipes,
  // privilege escalation, system-power) is DENY —
  // see the bash block. Precedence is last-match-wins (findLast in src/permission/index.ts), so the
  // bash wildcard is first and the specific deny/ask patterns that override it come after.
  "permission": {
    "read": "allow",
    "list": "allow",
    "glob": "allow",
    "grep": "allow",
    "lsp": "allow",
    "todowrite": "allow",
    "question": "allow",
    "task": "allow",
    // P11b: delegate is a slice-seat tool — only reasoner/oracle slice children get it
    // (childSlicePermission in slice-orchestrator.ts flips it to allow per seat). The root
    // session and every persona/raw-task child never see it.
    "delegate": "deny",
    "edit": "allow",
    "webfetch": "allow",
    "websearch": "allow",
    "doom_loop": "ask",
    "skill": "ask",
    // 09-ops-hands D1/D3: job actions (status/output/wait/kill) only ever touch jobs this
    // process itself spawned via bash's background:true — same trust boundary as bash, safe
    // to allow headless.
    "job": "allow",
    "external_directory": "deny",
    "bash": {
      // The majority of commands are ALLOW so the agent can build/test/run in a headless
      // `opencode run`. Reading the codebase still routes through econ's read tools — `cat`/`ls`/
      // `grep` are intercepted and bounced by shell.ts bashReadRedirect regardless of this allow.
      // Explicit danger floor below (DENY): destructive deletes, disk wipes, privilege escalation,
      // system-power. Outward/network (git push, curl, wget) stay ASK so an interactive root can
      // approve them while headless denies them. Mirror any change here into childSlicePermission
      // (slice-orchestrator.ts) so slice children carry the same floor.
      "*": "allow",
      "git push*": "ask",
      "curl *": "ask",
      "wget *": "ask",
      "sudo *": "deny",
      "su *": "deny",
      "doas *": "deny",
      "rm -rf *": "deny",
      "rm -fr *": "deny",
      "rm -r *": "deny",
      "dd *": "deny",
      "mkfs*": "deny",
      "shutdown*": "deny",
      "reboot*": "deny",
      "halt*": "deny",
      "poweroff*": "deny",
      "init 0*": "deny",
      "init 6*": "deny",
      "git clean -f*": "deny"
    }
  },

  // econ loop-on-deny — a denied tool call is returned to the model as feedback so it recovers
  // (e.g. a gated bash read → switch to read/search) instead of dead-ending the turn with no
  // output. Without this, processor.ts breaks the agent loop on the first deny (shouldBreak).
  "experimental": {
    "continue_loop_on_deny": true,
    "redirect_bash_reads": true
  },

  // econ LiteLLM gateway provider — the always-available global baseline. econ's self-hosted
  // LiteLLM gateway (infra/litellm/config.yaml) is an OpenAI-compatible custom provider that fronts
  // all four econ models with usage passthrough, so we declare it via @ai-sdk/openai-compatible
  // and pin the four tier model IDs so they resolve regardless of the upstream models.dev catalog.
  //
  // econ OL-7.5 adaptive plan-time reasoning — the conductor block below pins
  // options.reasoningEffort="none": deepseek-v4-flash is a hybrid model (reasoning is a toggle,
  // not a model swap) whose SERVER-SIDE default is thinking ON, so the off-switch must be explicit
  // (run-9 post-mortem, 2026-07-05 — an unbounded think hit the 8192 output cap and truncated the
  // turn). The explicit "none" is the near-zero-reasoning baseline a trivial turn takes.
  // The tier router (packages/opencode/src/session/tier-router.ts resolveTier) reuses the same
  // turn-open heaviness/risk signals to decide, per turn, whether to raise this to
  // options.reasoningEffort="high" for the decomposition step (packages/opencode/src/session/
  // prompt.ts, the createUserMessage seam) — never touching the oracle/reasoner (glm-5.2 /
  // deepseek-v4-pro, pinned high below) or the executor (gpt-oss-120b, which must never see
  // reasoning turned off). reasoning_effort is the standard OpenAI param — the OpenRouter-era
  // `reasoning: {effort, exclude}` object 400s at Fireworks ("Extra inputs are not permitted").
  // The config key above is the AI-SDK camelCase option (reasoningEffort); the SDK maps it to the
  // wire param reasoning_effort — a snake_case config key is silently clobbered by
  // @ai-sdk/openai-compatible (OL-9.6e, run-10 wire capture 2026-07-05).
  "provider": {
    "litellm": {
      "name": "econ LiteLLM gateway",
      "npm": "@ai-sdk/openai-compatible",
      "env": ["LITELLM_API_KEY"],
      "options": { "baseURL": "https://econ-litellm.fly.dev/v1", "headerTimeout": 45000, "chunkTimeout": 120000, "timeout": 300000 },
      "models": {
        "deepseek/deepseek-v4-flash": { "name": "DeepSeek V4 Flash (econ conductor)", "limit": { "context": 1000000, "output": 8192 }, "options": { "reasoningEffort": "none", "parallel_tool_calls": true } },
        "z-ai/glm-5.2": { "name": "GLM 5.2 (econ oracle)", "reasoning": true, "limit": { "context": 1048576, "output": 32768 }, "options": { "reasoningEffort": "high", "parallel_tool_calls": true } },
        "deepseek/deepseek-v4-pro": { "name": "DeepSeek V4 Pro (econ reasoner)", "reasoning": true, "limit": { "context": 1048576, "output": 32768 }, "options": { "reasoningEffort": "high", "parallel_tool_calls": true } },
        "openai/gpt-oss-120b": { "name": "gpt-oss-120b (econ executor/assistant)", "reasoning": true, "limit": { "context": 131072, "output": 8192 }, "options": { "reasoningEffort": "low", "parallel_tool_calls": true } },

        // Extra gateway/registry models. minimax-m3 is now the conductor tier (2026-07-09, provisional
        // experiment — see the conductor agent above); kimi-k2p7-code stays unbound catalog. Reasoning
        // channel OFF by default; set options.reasoningEffort per tier. minimax-m3: 512K floor (up to 1M). kimi: 256K.
        "minimax/minimax-m3": { "name": "MiniMax M3 (econ conductor — experiment)", "limit": { "context": 524288, "output": 64000 }, "options": { "reasoningEffort": "high", "parallel_tool_calls": true } },
        "moonshotai/kimi-k2p7-code": { "name": "Kimi K2.7 Code (catalog)", "limit": { "context": 262144, "output": 32768 }, "options": { "parallel_tool_calls": true } }
      }
    }
  }

  // econ in-region inference + data residency (S8.1) — GATED. Real in-region (India) OSS
  // endpoints are not yet provisioned; this is the scaffolding contract. To route a tier to
  // in-region infra, add a provider pointing at the India gateway (OpenAI-compatible) and point
  // the tier's agent model at "econ-in/<model>". The per-tier fallback chain + data-residency
  // policy lives in packages/code-intelligence/src/region.ts (DEFAULT_REGION_CONFIG,
  // resolveTierChain, selectEndpoint). See docs/features/07-hardening-hosting-ship.md.
  //
  // econ model fallback (S8.3) — expressed config-first: each tier's ordered endpoint chain is
  // held in region.ts (in-region preferred, global LiteLLM gateway as fallback). OpenCode has no
  // native per-model failover field, so runtime auto-failover on a 5xx is a GATED minimal
  // wrapper (docs/features/07-hardening-hosting-ship.md). The safe always-available baseline today is the litellm
  // provider above; small_model is pinned so housekeeping degrades cheaply.
}
