exports[`tool parameters JSON Schema (wire shape) webfetch 1`] = `
{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "cache_ref": {
      "description": "Opaque reference returned by a prior call. When present, skip the fetch and return the next page of previously-ranked passages at ~0 cost.",
      "type": "string",
    },
    "limit": {
      "description": "Maximum passages to return in this response. When set, enables paginated mode: response includes meta.cache_ref, meta.total, meta.more. Default is all passages.",
      "type": "number",
    },
    "offset": {
      "description": "0-based passage offset within the cached result set (default 0). Only used with cache_ref.",
      "type": "number",
    },
    "prompt": {
      "description": "Query / task description used to BM25-rank the extracted passages by relevance. Omit to return the top passages in document order.",
      "type": "string",
    },
    "top_k": {
      "description": "Maximum number of passages to rank and cache (default 50). Returned as-is when \`limit\` is absent; first page is returned when \`limit\` is set.",
      "type": "number",
    },
    "url": {
      "description": "The URL to fetch content from (must start with http:// or https://).",
      "type": "string",
    },
  },
  "required": [
    "url",
  ],
  "type": "object",
}
`;

exports[`tool parameters JSON Schema (wire shape) websearch 1`] = `
{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "cache_ref": {
      "description": "Opaque ref from a prior call — returns the next cached page at ~0 cost.",
      "type": "string",
    },
    "contextMaxCharacters": {
      "description": "Maximum characters for context string (passed to provider; BM25 pruning is applied on top)",
      "type": "number",
    },
    "depth": {
      "description": "0 (default) = return BM25-pruned lean snippets only, no page fetches. K (1–5) = auto-fetch the top-K result URLs in parallel, BM25-rank passages cross-document, and return only the relevant passages with per-source provenance. Raw pages are never returned.",
      "type": "number",
    },
    "limit": {
      "description": "Items per page (default 5 for snippets, 15 for depth passages).",
      "type": "number",
    },
    "livecrawl": {
      "description": "Live crawl mode - 'fallback': use live crawling as backup if cached content unavailable, 'preferred': prioritize live crawling (default: 'fallback')",
      "enum": [
        "fallback",
        "preferred",
      ],
      "type": "string",
    },
    "numResults": {
      "description": "Number of search results to return (default: 8)",
      "type": "number",
    },
    "offset": {
      "description": "0-based item offset for pagination (default 0). Used with cache_ref.",
      "type": "number",
    },
    "query": {
      "description": "Websearch query",
      "type": "string",
    },
    "token_budget": {
      "description": "Approximate token budget for the response (default 2000). Limits results/passages returned.",
      "type": "number",
    },
    "type": {
      "description": "Search type - 'auto': balanced search (default), 'fast': quick results, 'deep': comprehensive search",
      "enum": [
        "auto",
        "fast",
        "deep",
      ],
      "type": "string",
    },
  },
  "required": [
    "query",
  ],
  "type": "object",
}
`;

exports[`tool parameters JSON Schema (wire shape) write 1`] = `
{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
